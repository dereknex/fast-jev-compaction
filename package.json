{
  "name": "fast-jev-compaction-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model and Cloudflare Workers AI Clef.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dereknex/fast-jev-compaction.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspace=@dereknex/jev-compaction build && npm run sync:claude && npm run --workspace=@dereknex/pi-jev-compaction build",
    "sync:claude": "node scripts/sync-claude.js",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "validate:plugin": "claude plugin validate packages/claude-code/.claude-plugin/plugin.json",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-claude.js",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
