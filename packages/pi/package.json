{
  "name": "@dereknex/pi-jev-compaction",
  "version": "0.4.2",
  "description": "Verbatim context pruning for Pi using TypeSafe Jev decisions.",
  "author": "dereknex <derek@nextty.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction",
    "context",
    "jev",
    "clef",
    "pi"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dereknex/fast-jev-compaction.git",
    "directory": "packages/pi"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dereknex/jev-compaction": "^0.5.2",
    "xstate": "^5.33.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/pi-jev-compaction.ts"
    ]
  }
}
