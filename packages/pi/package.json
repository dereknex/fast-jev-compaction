{
  "name": "pi-fast-jev-compaction",
  "version": "0.3.0",
  "description": "Verbatim context pruning for Pi using TypeSafe Jev decisions.",
  "keywords": [
    "compaction",
    "context",
    "jev",
    "clef",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-jev-compaction": "*",
    "xstate": "^5.33.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
